@{
    ViewData["Title"] = "Tra cứu đơn";
}

<h1 class="cs-page-title mb-3">Tra cứu đơn theo mã</h1>

<form asp-controller="CheckIn" asp-action="Lookup" method="post" class="row g-2 align-items-end mb-3">
    <div class="col-12 col-md-5">
        <label for="bookingId" class="form-label">Mã đơn (BookingId)</label>
        <input id="bookingId" name="bookingId" type="number" min="1" class="form-control" required />
    </div>
    <div class="col-12 col-md-3">
        <button type="submit" class="btn btn-primary w-100">Tra cứu</button>
    </div>
</form>

<p class="small text-muted">
    Nhân viên chỉ xem thông tin cần cho vận hành; không xuất dữ liệu người dùng.
</p>
<a class="btn btn-outline-secondary" asp-controller="CheckIn" asp-action="Index">Quay lại soát vé</a>
