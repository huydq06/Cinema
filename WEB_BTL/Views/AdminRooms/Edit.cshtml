@model WEB_BTL.Domain.Entities.Room
@{
    ViewData["Title"] = "Sửa phòng chiếu";
}

<h1 class="cs-page-title mb-3">Sửa phòng: @Model.RoomName</h1>

<form asp-action="Edit" asp-route-id="@Model.RoomId" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="row g-3">
        <div class="col-12 col-md-6">
            <label asp-for="RoomName" class="form-label">Tên phòng</label>
            <input asp-for="RoomName" class="form-control" required maxlength="50" />
            <span asp-validation-for="RoomName" class="text-danger small"></span>
        </div>

        <div class="col-12 col-md-6">
            <label asp-for="RoomType" class="form-label">Loại phòng</label>
            <select asp-for="RoomType" class="form-select"
                    asp-items="Html.GetEnumSelectList<WEB_BTL.Domain.Enums.RoomType>()"></select>
            <span asp-validation-for="RoomType" class="text-danger small"></span>
        </div>

        <div class="col-12">
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Đang hoạt động</label>
            </div>
            <div class="form-text">
                Ngưng hoạt động chỉ chặn tạo suất chiếu mới; các suất đã mở bán vẫn giữ nguyên.
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
        <a asp-action="Seats" asp-route-id="@Model.RoomId" class="btn btn-outline-primary">Quản lý ghế</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
