@{
    ViewData["Title"] = "Giới thiệu Cinestar";
    ViewData["FullWidth"] = true;
}

<section class="cs-about-hero">
    <div class="container">
        <h1>Rạp phim <em>Cinestar</em><br>Đà Nẵng</h1>
        <p>Cinestar là rạp chiếu phim hiện đại tại Đà Nẵng, mang đến trải nghiệm điện ảnh chất lượng cao với hệ thống âm thanh Dolby và màn hình 4K cho khán giả mọi lứa tuổi.</p>
    </div>
</section>

<div class="container">
    <div class="cs-stats-row">
        <div class="cs-stat">
            <div class="cs-stat-num">8</div>
            <div class="cs-stat-label">Phòng chiếu</div>
        </div>
        <div class="cs-stat">
            <div class="cs-stat-num">1200</div>
            <div class="cs-stat-label">Ghế ngồi</div>
        </div>
        <div class="cs-stat">
            <div class="cs-stat-num">30+</div>
            <div class="cs-stat-label">Phim mỗi tháng</div>
        </div>
        <div class="cs-stat">
            <div class="cs-stat-num">2019</div>
            <div class="cs-stat-label">Năm thành lập</div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-md-7">
            <div class="cs-about-section">
                <h2>Câu chuyện của chúng tôi</h2>
                <p>Cinestar được thành lập năm 2019 với sứ mệnh mang điện ảnh chất lượng quốc tế đến với khán giả Đà Nẵng. Từ một rạp nhỏ với 3 phòng chiếu, chúng tôi đã phát triển thành cụm rạp 8 phòng với tổng sức chứa hơn 1200 chỗ ngồi.</p>
                <p>Chúng tôi tin rằng xem phim tại rạp là trải nghiệm không thể thay thế — tiếng động Dolby Atmos, màn hình 4K rộng lớn và không khí chung của khán phòng tạo nên điều mà màn hình nhỏ không bao giờ làm được.</p>
            </div>

            <div class="cs-about-section">
                <h2>Công nghệ & thiết bị</h2>
                <div class="cs-facilities">
                    <div class="cs-facility">
                        <div class="cs-facility-name">Màn hình 4K</div>
                        <div class="cs-facility-desc">Laser projection 4K trên mọi phòng chiếu, độ sáng cao nhất phân khúc</div>
                    </div>
                    <div class="cs-facility">
                        <div class="cs-facility-name">Dolby Atmos</div>
                        <div class="cs-facility-desc">Âm thanh không gian 3D với hơn 64 kênh độc lập</div>
                    </div>
                    <div class="cs-facility">
                        <div class="cs-facility-name">Ghế Premium</div>
                        <div class="cs-facility-desc">Ghế da ngả lưng tự động khu VIP, tầm nhìn không vướng mọi hàng</div>
                    </div>
                    <div class="cs-facility">
                        <div class="cs-facility-name">Đặt vé QR</div>
                        <div class="cs-facility-desc">Giữ ghế online, thanh toán và nhận vé QR không cần xếp hàng</div>
                    </div>
                    <div class="cs-facility">
                        <div class="cs-facility-name">Quầy đồ ăn</div>
                        <div class="cs-facility-desc">Bắp rang, nước và combo phục vụ trực tiếp tại phòng chiếu</div>
                    </div>
                    <div class="cs-facility">
                        <div class="cs-facility-name">Bãi đỗ xe</div>
                        <div class="cs-facility-desc">200 chỗ đỗ xe miễn phí cho khách xem phim</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-5">
            <div class="cs-about-section">
                <h2>Thông tin liên hệ</h2>
                <p>
                    <strong>Địa chỉ</strong><br>
                    123 Nguyễn Văn Linh, Phường Thạc Gián<br>
                    Quận Thanh Khê, Đà Nẵng
                </p>
                <p>
                    <strong>Điện thoại</strong><br>
                    0236 3888 999
                </p>
                <p>
                    <strong>Email</strong><br>
                    hotline@cinestar.vn
                </p>
                <p>
                    <strong>Giờ mở cửa</strong><br>
                    Thứ 2 – Thứ 6: 9:00 – 23:00<br>
                    Thứ 7 – Chủ nhật: 8:30 – 23:30
                </p>
            </div>

            <div class="cs-about-section">
                <h2>Chính sách đặt vé</h2>
                <p>Vé mua online được giữ chỗ 10 phút sau khi tạo đơn. Ghế chỉ được xác nhận sau khi thanh toán thành công.</p>
                <p>Khách tại quầy có thể mua vé trực tiếp bằng tiền mặt. Vé đã thanh toán không hoàn lại trong MVP này.</p>
                <a class="cs-btn cs-btn-primary" asp-controller="Movies" asp-action="Index">Xem lịch chiếu</a>
            </div>
        </div>
    </div>
</div>
