{
  "ConnectionStrings": {
    "CinemaDb": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Booking": {
    "HoldMinutes": 10,
    "SalesCloseMinutes": 10,
    "MaxSeats": 8,
    "MaxComboQuantity": 10,
    "MaxPendingBookingsPerMinute": 10
  },
  "Showtime": {
    "CleaningMinutes": 15
  },
  "Payments": {
    "Provider": "FakeGateway",
    "CallbackBaseUrl": "https://localhost:7017",
    "PollSeconds": 5
  },
  "Uploads": {
    "RootPath": "uploads",
    "PublicBasePath": "/uploads",
    "MaxBytes": 5242880,
    "MaxPixels": 25000000
  },
  "Workers": {
    "ExpireIntervalSeconds": 30,
    "ReconcileIntervalSeconds": 60
  },
  "Cultures": {
    "Default": "vi-VN",
    "Supported": [ "vi-VN", "en-US" ]
  }
}
