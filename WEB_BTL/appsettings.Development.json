{
  "ConnectionStrings": {
    "CinemaDb": "Server=(localdb)\\MSSQLLocalDB;Database=CinemaWeb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedOnStartup": true
  },
  "Payments": {
    "Provider": "FakeGateway",
    "FakeGatewaySecret": "dev-only-change-me-secret",
    "CallbackBaseUrl": "https://localhost:7017"
  },
  "DataProtection": {
    "KeysPath": "App_Data/keys"
  },
  "Seed": {
    "AdminEmail": "admin@cinema.local",
    "AdminPassword": "Admin@12345",
    "StaffEmail": "staff@cinema.local",
    "StaffPassword": "Staff@12345",
    "CustomerEmail": "customer@cinema.local",
    "CustomerPassword": "Customer@12345"
  }
}
