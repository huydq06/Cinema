@model IReadOnlyList<ShowtimeSummaryDto>
@{
    ViewData["Title"] = "Quầy bán vé";
    var date = ViewData["Date"] as string;
    var utcNow = DateTime.UtcNow;
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <h1 class="cs-page-title mb-0">Quầy bán vé</h1>
    <form method="get" asp-controller="Counter" asp-action="Index" class="d-flex gap-2 align-items-end">
        <div>
            <label for="date" class="form-label small mb-1">Ngày</label>
            <input id="date" name="date" type="date" value="@date" class="form-control form-control-sm" />
        </div>
        <button type="submit" class="btn btn-sm btn-primary">Xem</button>
    </form>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">Không có suất chiếu trong ngày này.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Giờ</th>
                    <th>Phim</th>
                    <th>Phòng</th>
                    <th>Giá gốc</th>
                    <th>Ghế đã bán/giữ</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var slot in Model)
                {
                    var canSell = slot.Status == "OnSale" && slot.StartAtUtc > utcNow.AddMinutes(10);
                    <tr>
                        <td>@slot.StartAtUtc.AddHours(7).ToString("HH:mm")</td>
                        <td>@slot.MovieTitle</td>
                        <td>@slot.RoomName</td>
                        <td>@slot.BasePrice.ToString("N0") đ</td>
                        <td>@slot.SoldSeats/@slot.TotalSeats</td>
                        <td>@slot.Status</td>
                        <td class="text-end">
                            @if (canSell)
                            {
                                <a class="btn btn-sm btn-primary" asp-controller="Counter" asp-action="Seats"
                                   asp-route-showtimeId="@slot.ShowtimeId">Bán vé</a>
                            }
                            else
                            {
                                <span class="text-muted small">Không bán</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="d-flex gap-2 mt-3">
    <a class="btn btn-outline-secondary" asp-controller="CheckIn" asp-action="Index">Soát vé</a>
    <a class="btn btn-outline-secondary" asp-controller="CheckIn" asp-action="Lookup">Tra cứu đơn</a>
</div>
